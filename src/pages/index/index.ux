<template>
  <div class="page" @swipe="onSwipe">
    <text class="back" @click="goBack">返回</text>
    <text class="title">{{view === 'detail' ? '词条详情' : '口袋词典'}}</text>

    <div if="{{view === 'search'}}" class="home">
      <text class="input" @click="showKeyboard">{{query || '输入英文 / 中文'}}</text>
      <text class="clear" @click="clearQuery">清空</text>
      <text class="status">{{keyboard && language === 'zh' ? ('拼音：' + (pinyin || '')) : status}}</text>
      <list if="{{items.length > 0}}" id="results" class="results" style="height: {{keyboard ? 72 : 244}}px;">
        <list-item for="{{items}}" tid="rowKey" type="result" class="result" @click="openDetail($item.id)">
          <div class="result-content">
            <text class="word">{{$item.word}}</text>
            <text class="summary">{{$item.translation}}</text>
          </div>
        </list-item>
      </list>
      <text if="{{items.length === 0}}" class="empty">{{status}}</text>
      <div if="{{!keyboard}}" class="pagination">
        <text class="page-button" style="color: {{offset > 0 && !loading ? '#ffffff' : '#777777'}};" @click="previousPage">上页</text>
        <text class="page-number">{{pageNumber}}</text>
        <text class="page-button next" style="color: {{hasMore && !loading ? '#ffffff' : '#777777'}};" @click="nextPage">下页</text>
      </div>
      <text if="{{error && !keyboard}}" class="retry" @click="retrySearch">点击重试</text>
    </div>

    <div if="{{view === 'detail'}}" class="detail">
      <list if="{{!detailLoading && !detailError}}" id="detailList" class="detail-list">
        <list-item for="{{detailRows}}" tid="key" type="definition" class="definition-row">
          <text class="{{$item.kind === 'word' ? 'detail-word' : ($item.kind === 'phonetic' ? 'phonetic' : 'translation')}}">{{$item.text}}</text>
        </list-item>
        <list-item for="{{relationRows}}" tid="key" type="relation" class="relation" @click="openDetail($item.id)">
          <div class="relation-content">
            <text class="relation-label">{{$item.label}}</text>
            <text class="relation-word">{{$item.word}}</text>
          </div>
        </list-item>
        <list-item if="{{relationTotal > 12}}" type="relation-page" class="relation-pager">
          <text class="relation-prev" @click="previousRelations">上页</text>
          <text class="relation-count">{{relationPage + 1}}</text>
          <text class="relation-next" @click="nextRelations">下页</text>
        </list-item>
      </list>
      <text if="{{detailLoading || detailError}}" class="detail-message" @click="retryDetail">{{detailLoading ? '正在读取词条…' : '读取失败，点击重试'}}</text>
    </div>

    <div if="{{keyboard}}" class="keyboard">
      <text if="{{language === 'en'}}" class="keyboard-caption" @click="resetKeys">{{group ? '返回字母分组' : 'EN · 英文'}}</text>
      <div if="{{language === 'zh'}}" class="candidate-bar">
        <text class="candidate-prev" @click="previousCandidates">上</text>
        <text for="{{candidateRows}}" class="candidate" style="left: {{$item.left}}px;" @click="chooseCandidate($item.text)">{{$item.text}}</text>
        <text if="{{candidateRows.length === 0}}" class="candidate-message" @click="refreshCandidates">{{candidateStatus}}</text>
        <text class="candidate-next" @click="nextCandidates">下</text>
      </div>
      <text for="{{keys}}" class="key" style="left: {{$item.left}}px; top: {{$item.top}}px;" @click="pressKey($item.value)">{{$item.label}}</text>
      <text class="language" @click="switchLanguage">{{language === 'en' ? '中文' : 'EN'}}</text>
      <text class="delete" @click="deleteCharacter">删除</text>
      <text class="space" @click="insertSpace">空格</text>
      <text class="hide" @click="hideKeyboard">收起</text>
    </div>
  </div>
</template>

<script>
import {createDictionary} from '../../common/search';
import file from '@system.file';
import app from '@system.app';

export default {
  private: {
    view: 'search', query: '', keyboard: false, language: 'en', pinyin: '',
    group: '', keys: [], items: [], offset: 0, pageNumber: 1, hasMore: false,
    loading: false, error: false, status: '输入单词开始查询',
    candidateRows: [], candidateOffset: 0, candidateStatus: '输入拼音',
    detailRows: [], relationRows: [], relationPage: 0, relationTotal: 0,
    detailLoading: false, detailError: false
  },
  onInit() {
    this._alive = true;
    this._generation = 0;
    this._candidateGeneration = 0;
    this._detailGeneration = 0;
    this._history = [];
    this._candidates = [];
    this._relations = [];
    this._api = createDictionary(path => new Promise((resolve, reject) => {
      file.readText({ uri: path, success: data => resolve(data.text), fail: reject });
    }));
    this.resetKeys();
  },
  onDestroy() {
    this._alive = false;
    this._generation++;
    this._candidateGeneration++;
    this._detailGeneration++;
    clearTimeout(this._searchTimer);
    clearTimeout(this._candidateTimer);
  },
  resetKeys() {
    this.group = '';
    this.setKeys(['abcde', 'fghij', 'klmno', 'pqrst', 'uvw', 'xyz']);
  },
  setKeys(values) {
    this.keys = values.map((value, index) => ({
      value, label: value === 'back' ? '分组' : value,
      left: 6 + (index % 3) * 110, top: 50 + Math.floor(index / 3) * 54
    }));
  },
  pressKey(value) {
    if (value === 'back') { this.resetKeys(); return; }
    if (!this.group) {
      this.group = value;
      this.setKeys(value.split('').concat(['back']));
      return;
    }
    if (this.language === 'zh') {
      if (this.pinyin.length < 24) this.pinyin += value;
      this.refreshCandidates();
    } else {
      if (this.query.length < 80) this.query += value;
      this.queueSearch();
    }
    this.resetKeys();
  },
  showKeyboard() { this.keyboard = true; },
  hideKeyboard() { this.keyboard = false; this.resetKeys(); },
  switchLanguage() {
    this.language = this.language === 'en' ? 'zh' : 'en';
    this.clearComposition();
    this.resetKeys();
  },
  clearComposition() {
    clearTimeout(this._candidateTimer);
    this._candidateGeneration++;
    this.pinyin = '';
    this._candidates = [];
    this.candidateRows = [];
    this.candidateOffset = 0;
    this.candidateStatus = '输入拼音';
  },
  clearQuery() {
    this.query = '';
    this.clearComposition();
    this.resetKeys();
    this.queueSearch();
  },
  deleteCharacter() {
    if (this.language === 'zh' && this.pinyin) {
      this.pinyin = this.pinyin.slice(0, -1);
      this.refreshCandidates();
    } else {
      this.query = Array.from(this.query).slice(0, -1).join('');
      this.queueSearch();
    }
    this.resetKeys();
  },
  insertSpace() {
    if (this.pinyin) {
      if (this.candidateRows.length) this.chooseCandidate(this.candidateRows[0].text);
      return;
    }
    if (this.query.length < 80) this.query += ' ';
    this.queueSearch();
  },
  queueSearch() {
    clearTimeout(this._searchTimer);
    // Invalidate immediately, including the debounce interval.
    const generation = ++this._generation;
    this.offset = 0;
    this.pageNumber = 1;
    this.items = [];
    this.hasMore = false;
    this.error = false;
    this.loading = !!this.query.trim();
    this.status = this.loading ? '正在查询…' : '输入单词开始查询';
    if (!this.loading) return;
    this._searchTimer = setTimeout(() => this.searchPage(0, generation), 160);
  },
  searchPage(offset, generation) {
    if (!this._alive || generation !== this._generation) return;
    const query = this.query;
    this.loading = true;
    this.error = false;
    this.items = [];
    this.hasMore = false;
    this.status = '正在查询…';
    this._api.search(query, offset, 12).then(result => {
      if (!this._alive || generation !== this._generation) return;
      this.items = result.items.slice(0, 12).map((item, index) => ({
        id: item.id, word: item.word, phonetic: item.phonetic,
        translation: item.translation, rowKey: generation + ':' + index
      }));
      this.offset = offset;
      this.pageNumber = Math.floor(offset / 12) + 1;
      this.hasMore = result.hasMore;
      this.loading = false;
      this.status = this.items.length ? '第 ' + this.pageNumber + ' 页' : '没有找到结果';
    }).catch(() => {
      if (!this._alive || generation !== this._generation) return;
      this.loading = false;
      this.error = true;
      this.status = '查询失败，请重试';
    });
  },
  retrySearch() { this.searchPage(this.offset, ++this._generation); },
  previousPage() {
    if (!this.loading && this.offset > 0) this.searchPage(this.offset - 12, ++this._generation);
  },
  nextPage() {
    if (!this.loading && this.hasMore) this.searchPage(this.offset + 12, ++this._generation);
  },
  refreshCandidates() {
    clearTimeout(this._candidateTimer);
    const generation = ++this._candidateGeneration;
    this._candidates = [];
    this.candidateRows = [];
    this.candidateOffset = 0;
    this.candidateStatus = this.pinyin ? '查询候选…' : '输入拼音';
    if (!this.pinyin) return;
    const pinyin = this.pinyin;
    this._candidateTimer = setTimeout(() => {
      if (!this._alive || generation !== this._candidateGeneration) return;
      this._api.candidates(pinyin).then(chars => {
        if (!this._alive || generation !== this._candidateGeneration) return;
        this._candidates = chars;
        this.candidateStatus = chars.length ? '' : '暂无候选';
        this.renderCandidates();
      }).catch(() => {
        if (!this._alive || generation !== this._candidateGeneration) return;
        this.candidateStatus = '失败，点此重试';
      });
    }, 120);
  },
  renderCandidates() {
    this.candidateRows = this._candidates.slice(this.candidateOffset, this.candidateOffset + 4)
      .map((text, index) => ({ text, left: 52 + index * 58 }));
  },
  previousCandidates() {
    this.candidateOffset = Math.max(0, this.candidateOffset - 4);
    this.renderCandidates();
  },
  nextCandidates() {
    if (this.candidateOffset + 4 < this._candidates.length) this.candidateOffset += 4;
    this.renderCandidates();
  },
  chooseCandidate(text) {
    if (!text || this.query.length + text.length > 80) return;
    this.query += text;
    this.clearComposition();
    this.resetKeys();
    this.queueSearch();
  },
  openDetail(id) {
    if (id === undefined || id === null) return;
    if (this.view === 'detail' && this._detailId !== undefined) {
      this._history.push(this._detailId);
      if (this._history.length > 24) this._history.shift();
    }
    this.hideKeyboard();
    this.view = 'detail';
    this.loadDetail(id);
  },
  loadDetail(id) {
    const generation = ++this._detailGeneration;
    this._detailId = id;
    this.detailLoading = true;
    this.detailError = false;
    this.detailRows = [];
    this.relationRows = [];
    this._api.get(id).then(entry => {
      if (!this._alive || generation !== this._detailGeneration) return;
      this.detailRows = [
        { key: 'word', kind: 'word', text: entry.word },
        { key: 'phonetic', kind: 'phonetic', text: entry.phonetic || '暂无音标' },
        { key: 'translation', kind: 'translation', text: entry.translation || '暂无释义' }
      ];
      this._relations = entry.relations || [];
      this.relationTotal = this._relations.length;
      this.relationPage = 0;
      this.renderRelations();
      this.detailLoading = false;
    }).catch(() => {
      if (!this._alive || generation !== this._detailGeneration) return;
      this.detailLoading = false;
      this.detailError = true;
    });
  },
  renderRelations() {
    this.relationRows = this._relations.slice(this.relationPage * 12, this.relationPage * 12 + 12)
      .map((item, index) => ({ id: item.id, word: item.word, label: item.label,
        key: this._detailGeneration + ':' + this.relationPage + ':' + index }));
  },
  previousRelations() {
    if (this.relationPage > 0) { this.relationPage--; this.renderRelations(); }
  },
  nextRelations() {
    if ((this.relationPage + 1) * 12 < this.relationTotal) {
      this.relationPage++;
      this.renderRelations();
    }
  },
  retryDetail() { if (!this.detailLoading) this.loadDetail(this._detailId); },
  goBack() {
    if (this.keyboard) { this.hideKeyboard(); return; }
    if (this.view === 'detail') {
      this._detailGeneration++;
      if (this._history.length) this.loadDetail(this._history.pop());
      else this.view = 'search';
      return;
    }
    this.onDestroy();
    app.terminate();
  },
  onSwipe(event) { if (event && event.direction === 'right') this.goBack(); },
  onBackPress() { this.goBack(); return true; }
}
</script>

<style>
.page { width: 336px; height: 480px; background-color: #000; color: #ffffff; }
.back { position: absolute; left: 6px; top: 12px; width: 72px; height: 48px; border-radius: 24px; background-color: #262626; color: #ffffff; font-size: 22px; text-align: center; }
.title { position: absolute; left: 92px; top: 12px; width: 232px; height: 48px; font-size: 32px; font-weight: bold; color: #ffffff; }
.home { position: absolute; left: 0px; top: 72px; width: 336px; height: 408px; }
.input { position: absolute; left: 6px; top: 0px; width: 246px; height: 60px; padding: 0px 16px; border-radius: 28px; background-color: #262626; color: #ffffff; font-size: 26px; lines: 1; text-overflow: ellipsis; }
.clear { position: absolute; left: 258px; top: 0px; width: 72px; height: 60px; border-radius: 28px; background-color: #262626; color: #ffffff; font-size: 22px; text-align: center; }
.status { position: absolute; left: 14px; top: 64px; width: 310px; height: 28px; color: #aaaaaa; font-size: 20px; lines: 1; text-overflow: ellipsis; }
.results { position: absolute; left: 6px; top: 92px; width: 324px; }
.result { width: 324px; height: 72px; margin-bottom: 6px; border-radius: 24px; background-color: #262626; }
.result-content { width: 324px; height: 72px; padding: 6px 16px; flex-direction: column; }
.word { width: 292px; height: 32px; font-size: 26px; font-weight: bold; color: #ffffff; lines: 1; text-overflow: ellipsis; }
.summary { width: 292px; height: 28px; font-size: 20px; color: #bcbcbc; lines: 1; text-overflow: ellipsis; }
.empty { position: absolute; left: 16px; top: 104px; width: 304px; height: 48px; font-size: 22px; color: #aaaaaa; text-align: center; }
.pagination { position: absolute; left: 6px; top: 344px; width: 324px; height: 56px; }
.page-button { position: absolute; left: 0px; top: 0px; width: 104px; height: 56px; border-radius: 26px; background-color: #262626; font-size: 24px; text-align: center; }
.next { left: 220px; }
.page-number { position: absolute; left: 110px; top: 0px; width: 104px; height: 56px; color: #ffffff; font-size: 24px; text-align: center; }
.retry { position: absolute; left: 68px; top: 220px; width: 200px; height: 56px; border-radius: 28px; color: #ffffff; background-color: #0d6eff; font-size: 24px; text-align: center; }
.detail { position: absolute; left: 0px; top: 72px; width: 336px; height: 408px; }
.detail-list { position: absolute; left: 6px; top: 0px; width: 324px; height: 402px; }
.definition-row { width: 324px; padding: 8px 12px; }
.detail-word { width: 300px; color: #ffffff; font-size: 32px; font-weight: bold; }
.phonetic { width: 300px; color: #4da3ff; font-size: 24px; }
.translation { width: 300px; color: #ffffff; font-size: 26px; }
.relation { width: 324px; margin-top: 8px; border-radius: 24px; background-color: #262626; }
.relation-content { width: 324px; padding: 12px 16px; flex-direction: column; }
.relation-label { width: 292px; color: #4da3ff; font-size: 20px; }
.relation-word { width: 292px; color: #ffffff; font-size: 26px; }
.relation-pager { width: 324px; height: 64px; margin-top: 8px; }
.relation-prev { width: 108px; height: 56px; color: #ffffff; background-color: #262626; border-radius: 24px; text-align: center; font-size: 24px; }
.relation-count { width: 108px; height: 56px; color: #ffffff; text-align: center; font-size: 24px; }
.relation-next { width: 108px; height: 56px; color: #ffffff; background-color: #262626; border-radius: 24px; text-align: center; font-size: 24px; }
.detail-message { position: absolute; left: 16px; top: 100px; width: 304px; height: 100px; color: #bcbcbc; text-align: center; font-size: 24px; }
.keyboard { position: absolute; left: 0px; top: 240px; width: 336px; height: 240px; background-color: #000; }
.keyboard-caption { position: absolute; left: 6px; top: 0px; width: 324px; height: 44px; color: #4da3ff; font-size: 22px; text-align: center; }
.candidate-bar { position: absolute; left: 0px; top: 0px; width: 336px; height: 44px; }
.candidate-prev { position: absolute; left: 6px; top: 0px; width: 44px; height: 44px; color: #aaaaaa; background-color: #262626; border-radius: 16px; font-size: 20px; text-align: center; }
.candidate-next { position: absolute; left: 286px; top: 0px; width: 44px; height: 44px; color: #aaaaaa; background-color: #262626; border-radius: 16px; font-size: 20px; text-align: center; }
.candidate { position: absolute; top: 0px; width: 56px; height: 44px; color: #ffffff; font-size: 26px; text-align: center; }
.candidate-message { position: absolute; left: 52px; top: 0px; width: 232px; height: 44px; color: #aaaaaa; font-size: 20px; text-align: center; }
.key { position: absolute; width: 104px; height: 48px; border-radius: 20px; background-color: #262626; color: #ffffff; text-align: center; font-size: 26px; }
.language { position: absolute; left: 6px; top: 164px; width: 78px; height: 68px; border-radius: 24px; background-color: #0d6eff; color: #ffffff; text-align: center; font-size: 22px; }
.delete { position: absolute; left: 88px; top: 164px; width: 78px; height: 68px; border-radius: 24px; background-color: #262626; color: #ffffff; text-align: center; font-size: 22px; }
.space { position: absolute; left: 170px; top: 164px; width: 78px; height: 68px; border-radius: 24px; background-color: #262626; color: #ffffff; text-align: center; font-size: 22px; }
.hide { position: absolute; left: 252px; top: 164px; width: 78px; height: 68px; border-radius: 24px; background-color: #0d6eff; color: #ffffff; text-align: center; font-size: 22px; }
</style>
