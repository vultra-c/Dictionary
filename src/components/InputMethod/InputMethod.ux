<template>
  <!-- rect-only 裁剪说明（化学工具箱）：本应用全部页面 screentype 写死 "rect"，
       circle/pill-shaped 分支及其 PNG 资产（full/t9/arc，~92KB）已整体删除——
       这些分支 if=false 永不建节点，删除后行为零差异；如需圆屏支持请从 git 历史恢复。
       键盘根节点：可见性直接由父组件传入的 hide prop 驱动（show="{{!hide}}"），
       不依赖 $watch 链与 setTimeout 定时器 —— 部分手环机型上 watch/定时器链不可靠，
       曾导致键盘永久不可见（且以 opacity:0 形式驻留挡住下层点击）。
       if 只挂在内部包装层（挂在根节点上会导致部分机型挂载/展开时崩溃重启）。
       入场动画仅锦上添花：watch 失灵时键盘也立即完整可见可用。 -->
  <div class="kbd-layer {{kbdState}}" style="flex-direction: column;" show="{{!hide}}">
    <!-- 键盘内容懒建：外 if 保证键盘隐藏时整个子树不进 VDOM（chat/search 首进 1s 卡顿根因：
         旧实现 show 只是不可见，200+ 节点/图片在进页瞬间全部创建），首次弹出才创建，
         之后 keyboardCreated 保活、hide 切换只走内层 show 显隐，不重复重建。 -->
    <div if="{{!hide || keyboardCreated}}">
      <div style="background-color:black;flex-direction: column;" >
      <!-- 拼音小字行：键盘框外上方单独一行，黑底覆盖，仅中/日模式且有 cval 时显示，只展示不可点。
           circle 屏彻底不建此节点（键盘固定 480x321，外置 28px 行会挤压键盘且顶部多一条黑条），
           circle 的拼音改在键盘内部绝对定位显示；if 而非 show：show 隐藏时节点仍在 VDOM，
           circle 顶部会残留黑条 -->
      <div if="{{screentype !== 'circle'}}" class="cvalrow-wrap" show="{{(lang==='cn' || lang==='jp' || lang==='en') && downFlag==='' && !numFlag && cval}}">
        <text class="cvalrow">{{cvalDisplay}}</text>
      </div>
      <!-- 方屏67 -->
      <div if="{{screentype==='rect'}}" style="width: 100%;height: 255px;flex-direction: column">
        <!-- 九键中文 -->
        <div if="{{keyboardtype=='T9' && !numFlag}}" style="position:absolute;top:0px;width:100%;height:276px;justify-content: center;">
          <div style="top:77px;height:189px;width:100%;align-items: stretch;justify-content: space-between;flex-direction: column;padding:6px 3px">
            <div class="keyboard-rows-rect-t9">
              <text class="calbtnt9 calbtnt9-rect" @click="onSelect('select')">
                选择
                <span if="{{waitingList.length != 0}}" class="waiting-keys" style="color:rgb(13,132,255);" @click="onSelectWaiting(waitingIndex)">
                  {{waitingList[waitingIndex].toUpperCase()}}
                </span>
              </text>
              <text class="calbtnt9 calbtnt9-rect" for="{{item in keys['t9'][0]}}" @click="onSelect(item)">{{item.toUpperCase()}}</text>
            </div>
            <div class="keyboard-rows-rect-t9">
              <text class="calbtnt9 calbtnt9-rect" for="{{item in keys['t9'][1]}}" @click="onSelect(item)">{{item.toUpperCase()}}</text>
            </div>
            <div class="keyboard-rows-rect-t9">
              <text class="calbtnt9 calbtnt9-rect" for="{{item in keys['t9'][2]}}" @click="onSelect(item)">{{item.toUpperCase()}}</text>
            </div>
          </div>
        </div>
        <div else style="position:absolute;top:0px;width:100%;height:276px;justify-content: center">
          <progress percent="{{percent67}}" style="position:absolute;bottom: 12px;width:80px;color:#ffffff;stroke-width:6px;layer-color:#262626;"></progress>
          <scroll id="keyboard67" scroll-x="{{true}}" onscroll="handelScroll">
            <div if="{{!numFlag}}" style="left: 6px; flex-direction: column;">
              <div static style="margin-left: 0px;margin-top: 0px;height: 60px;">
                <text class="calbtn67" for="{{item in keys['full'][0]}}" @click="onSelect(item)">{{item}}</text>
              </div>
              <div static style="margin-left: 32px;margin-top: -5px;height: 60px;">
                <text class="calbtn67" for="{{item in keys['full'][1]}}" @click="onSelect(item)">{{item}}</text>
              </div>
              <div static style="margin-left: 64px;margin-top: -5px;height: 60px;">
                <text class="calbtn67" for="{{item in keys['full'][2]}}" @click="onSelect(item)">{{item}}</text>
                <img static src="./assets/horizontal/space.png" style="width: 60px;height: 60px;" @click="onBtnClick('space')" />
              </div>
            </div>
            <div if="{{numFlag && !numFlag_jp}}" style="left: 6px; flex-direction: column;">
              <div static style="margin-left: 0px;margin-top: 0px;height: 60px;">
                <text class="calbtn67" for="{{item in keys['sign'][0]}}" @click="onSelect(item)">{{item}}</text>
              </div>
              <div static style="margin-left: 32px;margin-top: -5px;height: 60px;">
                <text class="calbtn67" for="{{item in keys['sign'][1]}}" @click="onSelect(item)">{{item}}</text>
              </div>
              <div static style="margin-left: 64px;margin-top: -5px;height: 60px;">
                <text class="calbtn67" for="{{item in keys['sign'][2]}}" @click="onSelect(item)">{{item}}</text>
              </div>
            </div>
            <div if="{{numFlag_jp}}" style="left: 6px; flex-direction: column;">
              <div static style="margin-left: 0px;margin-top: 0px;height: 60px;">
                <text class="calbtn67" for="{{item in keys['sign_jp'][0]}}" @click="onSelect(item)">{{item}}</text>
              </div>
              <div static style="margin-left: 32px;margin-top: -5px;height: 60px;">
                <text class="calbtn67" for="{{item in keys['sign_jp'][1]}}" @click="onSelect(item)">{{item}}</text>
              </div>
              <div static style="margin-left: 64px;margin-top: -5px;height: 60px;">
                <text class="calbtn67" for="{{item in keys['sign_jp'][2]}}" @click="onSelect(item)">{{item}}</text>
              </div>
            </div>
          </scroll>
        </div>
        <div style="width: 100%; flex-direction: row; justify-content: center; top:6px; padding:0 6px;">
          <div style="width: 60px;height: 60px;" if="{{downFlag==='' && !numFlag && lang==='cn'}}">
            <img src="./assets/horizontal/cn.png" style="width: 60px;height: 60px;" @click="onBtnClick('lang')" />
          </div>
          <div if="{{(lang === 'cn' || lang === 'jp' || lang === 'en') && !numFlag}}" style="margin-left: 6px;flex: 1;height: 60px;background-color:#262626;border-color: #333333; border-width: 3px; border-radius: 100px;flex-direction: row;align-items:center">
            <!-- 候选横滚行：整词在前、单字随后（拼音已在键盘上方独立小字行显示，这里不放 cval） -->
            <scroll id="cvalWaiting" scroll-x="{{true}}" style="position:absolute;width: 85%;height: 42px;">
              <div static style="position: absolute;left: 0px;height: 42px;padding-left:20px;padding-right:20px">
                <text for="{{resultRow0}}" show="{{resultRow0.length > $idx}}" class="calbtn02" style="padding-right:10px" @click="onRsSelect(resultRow0[$idx])">{{resultRow0[$idx]}}</text>
              </div>
            </scroll>
            <img if="{{resultRow0.length > 0}}" style="position:absolute;right: 8px; width: 60px;height: 40px;" src="./assets/horizontal/down2.png" @click="onBtnClick('down')" />
          </div>
          <div style="width: 60px;height: 60px;" if="{{downFlag==='' && !numFlag && lang==='en'}}">
            <img src="./assets/horizontal/en.png" style="width: 60px;height: 60px;" @click="onBtnClick('lang')" />
          </div>
          <div style="width: 94px;height: 60px;margin-left: 4px;" if="{{downFlag==='' && upperFlag && lang==='en' && !numFlag}}">
            <img src="./assets/horizontal/bigA.png" style="width: 94px;height: 60px;" @click="onBtnClick('switchLow')" />
          </div>
          <div style="width: 94px;height: 60px;margin-left: 4px;" if="{{downFlag==='' && !upperFlag && lang==='en' && !numFlag}}">
            <img src="./assets/horizontal/a.png" style="width: 94px;height: 60px;" @click="onBtnClick('switchUpper')" />
          </div>
          <div style="width: 94px;height: 60px;margin-left: 4px;" if="{{downFlag==='' && !numFlag && lang==='en'}}">
            <img src="./assets/horizontal/123.png" style="width: 94px;height: 60px;" @click="onBtnClick('switchNum')" />
          </div>
          <div style="width: 159px;height: 60px;" if="{{numFlag}}">
            <img src="./assets/horizontal/back2.png" style="width: 159px;height: 60px;" @click="onBtnClick('switchCn')" />
          </div>
          <div style="width: 60px;height: 60px;margin-left: 4px;" if="{{!numFlag}}">
            <img src="./assets/horizontal/del.png" style="width: 60px;height: 60px;" @click="onBtnClick('D')" />
          </div>
          <div style="width: 159px;height: 60px;margin-left: 4px;" else>
            <img src="./assets/horizontal/del2.png" style="width: 159px;height: 60px;" @click="onBtnClick('D')" />
          </div>
        </div>
        <!-- 下展候选：改用普通 scroll + text（与阅读器搜索结果同款交互，点击稳定），
             与全键盘/九键同款 list/list-item 方案（scroll+for 在本机候选展开时不稳定） -->
        <list style="width:324px;height:210px;border-radius:18px;background-color:#262626;border:3px solid rgba(255,255,255,0.06);" if="{{downFlag==='down'}}">
          <list-item type="waitingRows67" style="width:324px;height:58px;" for="{{resultList2Grid}}" tid="flat">
            <div class="kbd-cand-row">
              <text class="kbd-cand-chip" show="{{$item.s1}}" @click="onRsSelect($item.s1)">{{$item.s1}}</text>
              <text class="kbd-cand-chip" show="{{$item.s2}}" @click="onRsSelect($item.s2)">{{$item.s2}}</text>
              <text class="kbd-cand-chip" show="{{$item.s3}}" @click="onRsSelect($item.s3)">{{$item.s3}}</text>
              <text class="kbd-cand-chip" show="{{$item.s4}}" @click="onRsSelect($item.s4)">{{$item.s4}}</text>
              <text class="kbd-cand-chip" show="{{$item.s5}}" @click="onRsSelect($item.s5)">{{$item.s5}}</text>
              <text class="kbd-cand-chip" show="{{$item.s6}}" @click="onRsSelect($item.s6)">{{$item.s6}}</text>
            </div>
          </list-item>
        </list>
        <img static style="margin-top:5px" src="./assets/horizontal/up2.png" @click="onBtnClick('down')" show="{{downFlag==='down'}}" />
      </div></div>
      </div>
      </div>
    </div>
  </div>
</template>

<script>
import vibrator from "@system.vibrator";
import device from '@system.device'
import { SimpleInputMethod } from "./assets/dicUtil.js";
import { suggestEn } from "../../common/logic/dict.js";
function doSearchDic(word, lang, cb) {
  if (!word) {
    cb({ chars: [], multi: null });
    return;
  }

  const res = SimpleInputMethod.getHanzi(word, lang);
  cb({ chars: res.chars, matched: res.matched, multi: res.multi });
}

function deleteLast(t) {
  if (t) {
    return t.substr(0, t.length - 1);
  }
  return "";
}
export default {
  props: {
    hide: {
      default: true,
    },
    keyboardtype: {
      default: "QWERTY",
    },
    maxlength: {
      default: 5,
    },
    vibratemode: {
      default: "",
    },
    screentype: {
      default: "circle",
    },
  },
  data: {
    cval: "",
    // 拼音分词显示串（如 ni'hao），在 resetResultList 中随 cval 同步更新
    cvalDisplay: "",
    resultList: [],
    resultList2: [],
    // 下展候选的扁平数组（rect 屏普通 scroll 用）
    resultList2Grid: [],
    // 多拼：整词候选（最前）及其与单字合并后的首页展示序列与对应整词标记
    resultWordList: [],
    resultRow0: [],
    resultRow0IsWord: [],
    // 当前已匹配的拼音前缀长度（用于逐字递进选择：选一个单字只消费对应长度）
    matchedLen: 0,
    // 每音节首字 + 累计拼音偏移（逐字递进选择：选哪个字就消费到哪个偏移位置）
    sylTopChars: [],
    waitingList: [],
    waitingIndex: -1,
    lastWaitingStr: "",
    downFlag: "",
    lang: "cn",
    numFlag: false,
    numFlag_jp: false,
    upperFlag: false,
    // 键盘子树是否已建入 DOM：首次弹出置 true 保活（之后 hide 只走 show 显隐，不重建）
    keyboardCreated: false,
    // 入场动画状态：首次弹出时由 hide watch 切到 kbd-play；watch 失灵时键盘仍会
    // 因根节点 show="{{!hide}}" 立即完整可见，动画只是增强不是前提
    kbdState: "",
    cvalList: [0, 1, 2, 3, 4],
    percent67: 52,
    percent66: 0,
    // 针对screenShape为rect的设备，会自动获取screenWidth并绑定到根div
    // 这样便能同时适配n67和o65甚至是后续设备，但实际效果可能受designWidth影响
    screenWidth: 336,
    keys: {
      full: [
        ["Q", "W", "E", "R", "T", "Y", "U", "I", "O", "P"],
        ["A", "S", "D", "F", "G", "H", "J", "K", "L"],
        ["Z", "X", "C", "V", "B", "N", "M"],
      ],
      sign: [
        ["1", "2", "3", "4", "5", "6", "7", "8", "9", "0"],
        ["~", "!", "@", "#", "%", "“", "”", "*", "?", "/"],
        ["(", ")", "-", "_", ":", ";", "，", "。", "."],
      ],
      sign_jp: [
        ["1", "2", "3", "4", "5", "6", "7", "8", "9", "0"],
        ["~", "•", "@", "#", "%", "「", "」", "*", "?", "/"],
        ["(", ")", "-", "…", ":", ";", "、", "。", "!"],
      ],
      sign62: [
        ["2", "3", "4", "5", "6", "7", "8", "9"],
        ["!", "@", "#", "%", "“", "”", "*"],
        [")", "-", "_", ":", ";"],
      ],
      sign62_jp: [
        ["2", "3", "4", "5", "6", "7", "8", "9"],
        ["•", "@", "#", "%", "「", "」", "*"],
        [")", "-", "…", ":", ";"],
      ],
      full62: [
        ["W", "E", "R", "T", "Y", "U", "I", "O"],
        ["S", "D", "F", "G", "H", "J", "K"],
        ["X", "C", "V", "B", "N"],
      ],
      t9: [
        ["abc", "def"],
        ["ghi", "jkl", "mno"],
        ["pqrs", "tuv", "wxyz"],
      ],
    },
  },
  onInit() {
    if (this.maxlength) {
      const tempCvalList = [];
      for (let i = 0; i < this.maxlength; i++) {
        tempCvalList.push(i);
      }
      this.cvalList = tempCvalList;
    }
    if (this.screentype === "rect" || this.screentype === "pill-shaped") {
      this.adjustScreenWidth();
    }
    // 字典懒初始化：进入页面时不阻塞主线程（建词对象 + 3000 词 forwardIndex 遍历），
    // 延迟到首帧后初始化，避免「进入界面卡顿」。
    // 不依赖 hide watch（部分机型 watch 链不可靠导致 dict 永不初始化 → 候选恒空），
    // 改为在 onInit 统一延迟执行；initDict 幂等且 forwardIndex 分片构建（见 dicUtil.js）。
    this._ensureDictInitSoon();
    if (!this.hide) {
      // 挂载即展开的用法：键盘显式直接创建并保活
      this.keyboardCreated = true
    }
    this.$watch("hide", "watchHidePropsChange");
    this.$watch("maxlength", "watchMaxLengthPropsChange");
    this.$watch("keyboardtype", "watchKeyboardTypePropsChange");
  },
  onDestroy() {},
  addAllTxt(txt) {
    this.$emit("complete", { content: txt });
  },
  onRsSelect(txt) {
    this.onVibrate();
    this.$emit("diag", { msg: 'S:' + txt });  // DEBUG 诊断（下一版移除）
    // 检查是否为每音节首字 → 按偏移消费 cval 前缀
    var consumed = false;
    if (txt.length === 1 && this.sylTopChars.length > 0 && this.cval.length > 0) {
      for (var si = 0; si < this.sylTopChars.length; si++) {
        if (this.sylTopChars[si].char === txt && this.sylTopChars[si].offset > 0 && this.sylTopChars[si].offset <= this.cval.length) {
          this.cval = this.cval.slice(this.sylTopChars[si].offset);
          this.addAllTxt(txt);
          this.clearWaiting();
          this.resetResultList();
          this.downFlag = "";   // 下展 list 在 Vela 中缓存不刷新，先收回用顶行展示新数据
          consumed = true;
          break;
        }
      }
    }
    if (consumed) return;
    // 单字兜底：只消费已匹配的拼音前缀长度（兼容 matchedLen）
    if (txt.length === 1 && this.matchedLen > 0 && this.cval.length > this.matchedLen) {
      this.cval = this.cval.slice(this.matchedLen);
      this.addAllTxt(txt);
      this.clearWaiting();
      this.resetResultList();
      this.downFlag = "";
      return;
    }
    // 整词或多字：整体清空 cval 并一次输出
    this.cval = "";
    this.addAllTxt(txt);
    this.clearWaiting();
    this.resetResultList();
    this.downFlag = "";
  },
  onBtnClick(sign) {
    this.onVibrate();
    switch (sign) {
      case "AC":
        this.cval = "";
        this.clearWaiting();
        this.resetResultList();
        break;
      case "lang":
        // 仅保留 中文/英文 两种输入法（已按需求移除日文）
        this.lang = this.lang === "cn" ? "en" : "cn";
        this.cval = "";
        this.clearWaiting();
        this.resetResultList();
        break;
      case "D":
        if (this.waitingIndex >= 0) {
          this.clearWaiting();
          this.resetResultList();
        } else if (this.cval.length > 0) {
          this.cval = deleteLast(this.cval);
          this.resetResultList();
        } else {
          this.$emit("delete", {});
        }
        break;
      case "space":
        this.addAllTxt(" ");
        break;
      case "down":
        this.downFlag = this.downFlag === "down" ? "" : "down";
        // 下展候选数据惰性构建（按键路径只做标记，避免每键预算 120 项装箱网格）
        if (this.downFlag === "down") this.buildDownLists();
        break;
      case "select":
        if (this.lastWaitingStr != sign && this.lastWaitingStr) {
          if (this.lang === "cn" || this.lang === 'jp') {
            this.cval += this.waitingList[this.waitingIndex];
          } else {
            if (this.upperFlag) {
              this.addAllTxt(this.waitingList[this.waitingIndex].toUpperCase());
            } else {
              this.addAllTxt(this.waitingList[this.waitingIndex].toLowerCase());
            }
          }
          this.clearWaiting();
          this.resetResultList();
        }
        break;
      case "switchNum":
        this.numFlag = true;
        this.numFlag_jp = false;
        this.cval = "";
        this.clearWaiting();
        this.resetResultList();
        break;
      case "switchNum_jp":
        this.numFlag = true;
        this.numFlag_jp = true;
        this.cval = "";
        this.clearWaiting();
        this.resetResultList();
        break;
      case "switchCn":
        this.numFlag = false;
        this.numFlag_jp = false;
        break;
      case "switchUpper":
        this.upperFlag = true;
        break;
      case "switchLow":
        this.upperFlag = false;
        break;
      default:
        if (sign.length === 1) {
          this.addAllTxt(sign);
        } else {
          if (this.waitingIndex >= 0) {
            if (this.lastWaitingStr === sign) {
              this.waitingIndex++;
              if (this.waitingIndex >= this.lastWaitingStr.length) {
                this.waitingIndex = 0;
              }
            } else {
              if (this.lang === "cn" || this.lang === 'jp') {
                this.cval += this.waitingList[this.waitingIndex];
              } else {
                if (this.upperFlag) {
                  this.addAllTxt(
                    this.waitingList[this.waitingIndex].toUpperCase(),
                  );
                } else {
                  this.addAllTxt(
                    this.waitingList[this.waitingIndex].toLowerCase(),
                  );
                }
              }
              this.lastWaitingStr = sign;
              this.waitingIndex = 0;
              this.waitingList = sign.split("");
            }
          } else {
            this.lastWaitingStr = sign;
            this.waitingIndex = 0;
            this.waitingList = sign.split("");
          }
          this.resetResultList();
        }
        break;
    }
  },
  clearWaiting() {
    this.waitingList = [];
    this.waitingIndex = -1;
    this.lastWaitingStr = "";
  },
  resetResultList() {
    // 候选查询前确保字典已就绪（幂等）：无论 hide watch / 定时器是否可靠触发，
    // 首次按键都会同步补齐字典初始化，避免「输入字母却永不弹中文候选」。
    this._ensureDictInit();
    let watingStr = "";
    if (this.lastWaitingStr && this.lastWaitingStr[this.waitingIndex]) {
      watingStr = this.lastWaitingStr[this.waitingIndex];
    }
    // 拼音分词显示：cn 模式显示 ni'hao 形式，jp/en/空串保持原样
    this.cvalDisplay = (this.lang === "cn")
      ? SimpleInputMethod.getSegmentedDisplay(this.cval + watingStr)
      : (this.cval + watingStr);
    if (!(this.cval + watingStr)) {
      this.resultList = [];
      this.resultWordList = [];
      this.setResultListAll();
      return;
    }
    // 英文模式：符号联想（逻辑对齐中文——第一个候选为输入本身，随后为元素符号前缀联想）
    if (this.lang === "en") {
      this.applyEnglishCandidates(this.cval + watingStr);
      return;
    }
    if (this.lang !== "cn" && this.lang !== "jp") {
      this.resultList = [];
      this.resultWordList = [];
      this.setResultListAll();
      return;
    }
    this.getResultByWord(this.cval + watingStr);
  },

  /**
   * 英文词典联想：输入前缀 → [输入本身, 词典前缀补全候选…]。
   * 与中文整词上屏路径完全一致（resultWordList → resultRow0 → onRsSelect 整词消费），
   * 如输入 ap → [ap, apple, apply, apart, approach…]（文件引擎桶窗扩散，见 common/logic/dict.js）。
   * 引擎异步：先同步上屏输入本身（候选行即时可点），命中返回后再丰富候选（~10-50ms）。
   */
  applyEnglishCandidates(input) {
    this.resultList = [];
    this.matchedLen = 0;
    this.sylTopChars = [];
    this.resultWordList = [input];
    this.setResultListAll();
    const me = this;
    const snap = String(input).toLowerCase();
    suggestEn(input, 12, function (hits) {
      // 过期守卫：输入已变化则丢弃本次异步结果（对齐 cn 候选不串键程）
      var waiting = (me.lastWaitingStr && me.lastWaitingStr[me.waitingIndex]) ? me.lastWaitingStr[me.waitingIndex] : "";
      if ((me.cval + waiting).toLowerCase() !== snap) return;
      var out = [input];
      if (hits) {
        for (var i = 0; i < hits.length && out.length < 13; i++) {
          out.push(hits[i]);
        }
      }
      me.resultWordList = out;
      me.setResultListAll();
    });
  },
  setResultListAll() {
    // 首页展示序列：整词在前，单字随后，截断到 maxlength
    const cap = parseInt(this.maxlength);
    let row0 = [];
    let row0IsWord = [];
    for (let i = 0; i < this.resultWordList.length && row0.length < cap; i++) {
      row0.push(this.resultWordList[i]);
      row0IsWord.push(true);
    }
    // 单字候选去重：同音单字串首字可能与整词/逐字首字重复（如 shishei 的「是」），跳过
    for (let i = 0; i < this.resultList.length && row0.length < cap; i++) {
      if (this.resultWordList.indexOf(this.resultList[i]) !== -1) continue;
      row0.push(this.resultList[i]);
      row0IsWord.push(false);
    }
    this.resultRow0 = row0;
    this.resultRow0IsWord = row0IsWord;

    // 下展分页/装箱网格（最多 120 候选）惰性构建：
    // 键盘收起时这些数据模板根本不渲染，按键路径只做脏标记；
    // 真正构建发生在 onBtnClick('down') 展开时（或已展开时源变化即时刷新）。
    this._downDirty = true;
    if (this.downFlag === 'down') this.buildDownLists();
  },
  buildDownLists() {
    if (!this._downDirty) return;
    this._downDirty = false;
    const cap = parseInt(this.maxlength);
    // 下展分页（down 展开）：整词优先，再单字，每页 maxlength 个
    this.resultList2 = [];
    let array = [];
    for (let i = 0; i < this.resultWordList.length; i++) {
      array.push(this.resultWordList[i]);
      if (array.length === cap) {
        this.resultList2.push(array);
        array = [];
      }
    }
    for (let i = 0; i < this.resultList.length; i++) {
      if (this.resultWordList.indexOf(this.resultList[i]) !== -1) continue;
      array.push(this.resultList[i]);
      if (array.length === cap) {
        this.resultList2.push(array);
        array = [];
      }
    }
    if (array.length > 0) {
      this.resultList2.push(array);
    }
    // rect 屏下展候选：贪心装箱成芯片行。估宽按设备实测上限取值
    // （单字实际约 66px：24 字宽 + 28 内边距 + 8 间距，粗体 CJK 步进可能大于字号），
    // 宁可每行少放也不允许行溢出——行溢出会触发 flex 默认压缩（flex-shrink=1），
    // 整行每个候选右边被裁掉一点；最后一行不满、不压缩，正是此前“只有末行正常”的原因。
    // 行对象固定 s1..s6 六个槽位，模板零运算符渲染；空槽 show=false 自动塌缩。
    this.resultList2Grid = []
    const candItems = []
    for (let i = 0; i < this.resultList2.length; i++) {
      for (let j = 0; j < this.resultList2[i].length; j++) {
        if (candItems.length >= 120) break
        candItems.push(this.resultList2[i][j])
      }
      if (candItems.length >= 120) break
    }
    let gRow = []
    let gW = 0
    for (let k = 0; k < candItems.length; k++) {
      const est = candItems[k].length * 30 + 38
      if (gRow.length >= 6 || ((gW + est) > 300 && gRow.length > 0)) {
        this.resultList2Grid.push(packCandRow(gRow, this.resultList2Grid.length))
        gRow = []
        gW = 0
      }
      gRow.push(candItems[k])
      gW += est
    }
    if (gRow.length > 0) {
      this.resultList2Grid.push(packCandRow(gRow, this.resultList2Grid.length))
    }

    function packCandRow(arr, idx) {
      const o = { flat: 'r' + idx, s1: '', s2: '', s3: '', s4: '', s5: '', s6: '' }
      for (let t = 0; t < arr.length && t < 6; t++) {
        o['s' + (t + 1)] = arr[t]
      }
      return o
    }
  },
  getResultByWord(val) {
    const that = this;
    doSearchDic(val, that.lang, function (data) {
      that.resultList = data.chars;                       // 单字候选（沿用）
      that.matchedLen = data.matched ? data.matched.length : 0;
      const multi = data.multi || { words: [], composed: "", sylTopChars: [] };
      that.sylTopChars = (multi.sylTopChars || []).filter(function(sc) { return sc.char && sc.offset > 0; });
      let words = (multi.words || []).slice();
      // 词库未命中但分词组合出多字串 → 也作为一条整词候选（排在整词区末尾，但在逐字首字之前）
      if (words.length === 0 && multi.composed && multi.composed.length >= 2) {
        words = [multi.composed];
      } else if (multi.composed && multi.composed.length >= 2 && words.indexOf(multi.composed) === -1) {
        words.push(multi.composed);
      }
      // 每音节首字放在整词后面、同音单字前面
      const sylOnlyChars = that.sylTopChars.map(function(sc) { return sc.char; });
      // 去重：音节首字列表中可能重复，从前往后去重
      const seen = {};
      const uniqueSylChars = [];
      for (var si = 0; si < sylOnlyChars.length; si++) {
        if (!seen[sylOnlyChars[si]]) { seen[sylOnlyChars[si]] = 1; uniqueSylChars.push(sylOnlyChars[si]); }
      }
      for (var si = 0; si < uniqueSylChars.length; si++) {
        if (words.indexOf(uniqueSylChars[si]) === -1) { words.push(uniqueSylChars[si]); }
      }
      that.resultWordList = words;
      that.setResultListAll();
    });
  },
  onSelect(num) {
    this.$emit("keyDown", { content: num });
    if (this.keyboardtype === "T9" && this.screentype !== "pill-shaped") {
      this.onBtnClick(num);
      return;
    }
    this.onVibrate();
    if ((this.lang === 'cn' || this.lang === 'jp')  && !this.numFlag) {
      this.cval += num.toLowerCase();
    } else if (this.lang === "en" && !this.numFlag) {
      // 英文符号联想模式：字母先聚到 cval，由候选行展示联想（对齐中文输入逻辑），
      // 点候选整体/逐键均可；尊重大小写锁定（upperFlag 大写）。
      this.cval += this.upperFlag ? num.toUpperCase() : num.toLowerCase();
    } else {
      this.addAllTxt(num);
    }
    this.resetResultList();
  },
  onSelectWaiting(num) {
    this.onVibrate();
    if (this.lang === "cn") {
      this.cval += this.waitingList[num].toString();
    } else {
      if (this.upperFlag) {
        this.addAllTxt(this.waitingList[num].toUpperCase());
      } else {
        this.addAllTxt(this.waitingList[num].toLowerCase());
      }
    }
    this.clearWaiting();
    this.resetResultList();
  },
  watchHidePropsChange(newV, oldV) {
    this.$emit("visibilityChange", { visible: newV });
    if (newV === false) {
      // 键盘从隐藏切到显示：首次弹出才把键盘子树建入 DOM（keyboardCreated 置 true 保活，
      // 之后 hide 切换只走 show 显隐、不再重建），同时懒初始化字典（幂等）。
      // 可见性本身由根节点 show="{{!hide}}" 直接保证，这里的类名切换只为入场动画。
      this.keyboardCreated = true;
      this._ensureDictInit();
      this.kbdState = "kbd-play";
    }
    // 收起方向无需任何处理：show 绑定立即隐藏键盘，子树保活供下次秒开。
  },
  // 字典懒初始化入口（幂等，只跑一次）。initDict 内部还有 syllableSet 幂等守卫。
  // started 标志在 initDict 成功返回后才置位：若初始化抛异常（如某机型 JS 引擎不支持
  // 部分语法），下次可重试，否则标志提前置位会导致字典永不重建、候选恒空。
  _ensureDictInit() {
    if (this.__dictInitStarted) return
    try {
      SimpleInputMethod.initDict()
      this.__dictInitStarted = true
    } catch (err) {
      // 机型 JS 引擎兼容性问题：本轮初始化失败不置标志，下次按键时自动重试
      console.warn('[InputMethod] dict init failed, will retry', err && err.message)
    }
  },
  // 首帧后启动字典初始化：不阻塞进入页面，也不依赖 hide watch 链（部分机型 watch 不可靠）。
  // 引擎若在 setTimeout 回调前已初始化，本定时器也幂等跳过。
  _ensureDictInitSoon() {
    if (this.__dictInitStarted) { return }
    setTimeout(() => {
      this._ensureDictInit();
    }, 0)
  },
  watchMaxLengthPropsChange(newV, oldV) {
    if (newV) {
      const tempCvalList = [];
      for (let i = 0; i < newV; i++) {
        tempCvalList.push(i);
      }
      this.cvalList = tempCvalList;
    }
  },
  watchKeyboardTypePropsChange(newV, oldV) {
    if (newV === "T9" && this.lang === "jp") {
      this.lang = "cn";
      this.cval = "";
      this.clearWaiting();
      this.resetResultList();
    }
  },
  onVibrate() {
    if (this.vibratemode != "") {
      vibrator.vibrate({ mode: this.vibratemode });
    }
  },
  handelScroll(event) {
    // 横滑进度条减帧：滚动事件高频触发，percent 变化不足阈值时不回写，
    // 避免 progress 组件每帧重建导致键盘区横滑掉帧（真机卡顿排查 2026-09）。
    let percentTemp67 = (event.scrollX / 636) * 100 + 52.8;
    const next67 = parseInt(percentTemp67 <= 100 ? percentTemp67 : 100);
    if (Math.abs(next67 - this.percent67) >= 2) this.percent67 = next67;
    let percentTemp66 = (event.scrollX / 633) * 100;
    const next66 = parseInt(percentTemp66 <= 100 ? percentTemp66 : 100);
    if (Math.abs(next66 - this.percent66) >= 2) this.percent66 = next66;
  },
  pushCval() {
    this.onVibrate();
    let temp = this.cval;
    this.cval = "";
    this.clearWaiting();
    this.resetResultList();
    this.addAllTxt(temp);
  },
  adjustScreenWidth(){
    device.getInfo({
      success: (data) => {
        this.screenWidth = data.screenWidth;
      }
    })
  }
};
</script>

<style>
.kbd-layer {
	width:100%;
	position:absolute;
	left:0;
	bottom:0
}
/* 入场滑入动画：仅锦上添花。可见性由根节点 show="{{!hide}}" 保证，
   动画类切换失败时键盘依然完整可见可用。
   组件类名统一 kbd- 前缀，避免与宿主页面全局样式（如 .page）互相覆盖。 */
.kbd-play {
	animation-name: kbd-enter;
	animation-duration: 300ms;
	animation-timing-function: ease-out;
}
@keyframes kbd-enter {
	0% {
		opacity: 0;
		transform: translateY(100%);
	}
	100% {
		opacity: 1;
		transform: translateY(0%);
	}
}
.item {
	height:52px;
	flex:1
}
.calbtn0 {
	color:#fff;
	font-size:28px;
	background-color:rgba(38,38,38,0);
	border-radius:0;
	height:52px;
	width:52px;
	text-align:center
}
.calbtn02 {
	color:rgb(255,255,255);
	background-color:rgba(38,38,38,0);
	border-radius:0px;
	font-size:32px;
	text-align:center;
	height:42px;
}
/* 下展分页候选按钮：宽度按文字自适应，不截断长词；覆盖各屏候选 class 的固定 width */
.calbtn-down {
	width:auto;
	min-width:52px;
	padding-left:14px;
	padding-right:14px;
	text-align:center;
}
/* 下展分页候选文字：text 默认按内容自适应宽度，不会被固定宽度截断 */
.calbtn-down-text {
	color:#ffffff;
	font-size:28px;
	margin-left:10px;
	margin-right:10px;
	lines:1;
	text-overflow:ellipsis;
}
.calbtnfull {
	color:#fff;
	font-size:24px;
	font-weight:bold;
	background-color:#262626;
	border-radius:12px;
	margin-right:4px;
	height:52px;
	width:40px;
	text-align:center;
	border:3px solid rgba(255,255,255,0.06)
}
.calbtnt9 {
	color:#fff;
	font-size:25px;
	font-weight:bold;
	background-color:#262626;
	border-radius:999px;
	margin-right:4px;
	width:94px;
	height:60px;
	text-align:center;
	border:3px solid rgba(255,255,255,0.06)
}
.caltext {
	text-align:left;
	line-height:38px;
	lines:1;
	text-overflow:ellipsis;
	color:#0d84ff;
	height:45px;
	font-size:28px;
	text-align:left;
	font-weight:bold;
	padding-left:8px
}
/* 拼音小字行：键盘框外上方单独一行显示 cval，单行裁剪、不可点 */
.cvalrow-wrap {
	width:100%;
	height:28px;
	background-color:#000000;
}
.cvalrow {
	color:#0d84ff;
	font-size:22px;
	font-weight:bold;
	lines:1;
	text-overflow:ellipsis;
	text-align:left;
	padding-left:14px;
	width:100%;
}
.list3 {
	position:absolute;
	top:38px;
	left:78px;
	width:324px;
	height:160px;
	flex-direction:column;
	background-color:#262626;
	border-radius:12px
}
.item3 {
	width:324px;
	height:52px
}
.calbtn67 {
	color:rgb(255,255,255);
	font-size:32px;
	font-weight:bold;
	background-color:rgb(38,38,38);
	margin-right:4px;
	width:60px;
	height:60px;
	border-radius:30px;
	text-align:center;
	border:3px solid rgba(255,255,255,0.06);
}
#keyboard67 {
	position:absolute;
	left:0px;
	top:82px;
	width:100%;
	height:170px;
}
#keyboard66 {
	position:absolute;
	left:0px;
	top:82px;
	width:100%;
	height:170px;
}
.list67 {
	top:0px;
	width:96.4%;
	height:170px;
	border-radius:30px;
	background-color:#262626;
	border:3px solid rgba(255,255,255,0.06);
	padding:0px 10px;
}
.item67 {
	height:50px;
}
/* rect 屏下展候选：滚动列表，整词/单字逐行显示，点击即选 */
.kbd-down-scroll {
	width:96.4%;
	height:170px;
	border-radius:30px;
	background-color:#262626;
	border:3px solid rgba(255,255,255,0.06);
	padding:0px 10px;
}
.kbd-down-row {
	width:100%;
	height:52px;
	justify-content:center;
	align-items:center;
	border-bottom:1px solid rgba(255,255,255,0.08);
}
/* rect 下展候选芯片行：左对齐流式排布，空槽塌缩不占位 */
.kbd-cand-row {
	width: 324px;
	height: 58px;
	flex-direction: row;
	justify-content: flex-start;
	align-items: center;
	padding-left: 10px;
	border-bottom: 1px solid rgba(255,255,255,0.08);
}
.kbd-cand-chip {
	flex-shrink: 0;
	height: 44px;
	padding-left: 14px;
	padding-right: 14px;
	margin-right: 8px;
	border-radius: 22px;
	background-color: #1c1c1e;
	color: #ffffff;
	font-size: 24px;
	font-weight: bold;
	text-align: center;
	lines: 1;
}
.calbtn66 {
	color:rgb(255,255,255);
	font-size:32px;
	font-weight:bold;
	background-color:rgb(38,38,38);
	margin-right:3px;
	width:60px;
